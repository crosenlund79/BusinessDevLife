; Engine configuration file.
; Business as Usual — Prototype 001 "Welcome to the Company"

config_version=5

[application]

config/name="Business as Usual"
config/description="Prototype 001 — Welcome to the Company. A workplace comedy about people, projects, progress, profit, and a bit of chaos."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Loc="*res://scripts/autoload/loc.gd"
Game="*res://scripts/autoload/game_state.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.95, 0.89, 0.8, 1)
textures/default_filters/anisotropic_filtering_level=3
